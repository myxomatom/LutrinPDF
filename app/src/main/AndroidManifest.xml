<!-- No <uses-permission> on purpose: no network, no broad storage access (SPEC.md §1).
     ./gradlew check fails if any dependency adds one (verifyReleasePermissions). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Backups are disabled: recent documents, reading positions and settings stay on this
         device and never reach a cloud backup (SPEC.md §3, Vie privée; ADR 0004).
         Predictive back is turned on for Android 13 to 15 (Android 16 and later turn it on for
         apps targeting them): the back gesture then drives the transition from the reader to
         the library, page shrinking into its thumbnail (ADR 0019). -->
    <application
        android:name=".LutrinApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lutrin">

        <!-- The only exported component. Standard launch mode on purpose: a document opened from
             another app shows in that app's task, and back returns to it (ADR 0014). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- « Ouvrir avec » (F01): PDF served by a content provider only. No file:// (it bypasses
                 the Storage Access Framework), no web link, no BROWSABLE, no wildcard type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:mimeType="application/pdf"
                    android:scheme="content" />
            </intent-filter>
            <!-- « Partager » (F01): a single PDF in EXTRA_STREAM. SEND_MULTIPLE belongs to the merge
                 tool (M6). The URI is checked by ParseIncomingDocumentUseCase. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>
</manifest>
