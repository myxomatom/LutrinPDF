    <string name="settings_follow_dark_theme_summary">Night mode for documents while the app is dark, until you choose their colours in the reader</string>
    <string name="settings_dynamic_color">Dynamic colours</string>
    <string name="settings_dynamic_color_summary">Use the colours of your wallpaper</string>
    <string name="settings_dynamic_color_unavailable">Available from Android 12</string>
    <string name="settings_section_reading">Reading</string>
    <!-- Keeps the screen on while a document is shown (ADR 0029). -->
    <string name="settings_keep_screen_on">Keep the screen on</string>
    <string name="settings_keep_screen_on_summary">While you read a document</string>
