        <item quantity="one">%d document will be removed from the list, with its thumbnail and the page where you stopped. The file itself is not deleted.</item>
        <item quantity="other">%d documents will be removed from the list, with their thumbnails and the pages where you stopped. The files themselves are not deleted.</item>
    </plurals>
    <string name="settings_clear_recents_confirm">Clear</string>
    <string name="settings_clear_recents_cancel">Cancel</string>
